#!/usr/bin/env bash
set -euo pipefail

# Runs the exact gate suite that CI runs. If any step fails the push is aborted.
# To install: `git config core.hooksPath .githooks && chmod +x .githooks/pre-push`

# Git exports GIT_DIR and friends to hooks (always from a worktree). The gates
# create their own throwaway repositories, which must never inherit them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# Each step prints its wall seconds; the total prints at the end.
started=$SECONDS
step_started=$SECONDS
step() {
  if [ -n "${step_name:-}" ]; then
    echo "  ${step_name%%]*}] took $((SECONDS - step_started))s"
  fi
  step_name="$1"
  step_started=$SECONDS
  echo "$1"
}

step "[1/6] cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

step "[2/6] cargo nextest run --no-fail-fast, then cargo test --doc"
if ! cargo nextest --version >/dev/null 2>&1; then
  echo "cargo-nextest is missing: cargo install cargo-nextest --locked" >&2
  exit 1
fi
cargo nextest run --no-fail-fast
cargo test --doc

step "[3/6] python3 -m ruff check scripts/ tests/ --select E,F,W,I --ignore E501"
python3 -m ruff check scripts/ tests/ --select E,F,W,I --ignore E501

step "[4/6] python3 -m ruff format --check scripts/ tests/"
python3 -m ruff format --check scripts/ tests/

step "[5/6] wh check --ci (self-check: Whetstone's own must rules)"
cargo build --quiet
scripts/self-check.sh "${CARGO_TARGET_DIR:-target}/debug/whetstone"

step "[6/6] python3 -m pytest -q"
python3 -m pytest -q

step "All gates passed in $((SECONDS - started))s. Pushing."
