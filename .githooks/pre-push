#!/usr/bin/env bash
set -euo pipefail

# Runs the exact gate suite that CI runs. If any step fails the push is aborted.
# To install: `git config core.hooksPath .githooks && chmod +x .githooks/pre-push`

# Git exports GIT_DIR and friends to hooks (always from a worktree). The gates
# create their own throwaway repositories, which must never inherit them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# Each step prints its wall seconds; the total prints at the end.
started=$SECONDS
step_started=$SECONDS
step() {
  if [ -n "${step_name:-}" ]; then
    echo "  ${step_name%%]*}] took $((SECONDS - step_started))s"
  fi
  step_name="$1"
  step_started=$SECONDS
  echo "$1"
}

step "[1/8] cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

step "[2/8] cargo test"
cargo test

step "[3/8] python3 -m ruff check scripts/ tests/ --select E,F,W,I --ignore E501"
python3 -m ruff check scripts/ tests/ --select E,F,W,I --ignore E501

step "[4/8] python3 -m ruff format --check scripts/ tests/"
python3 -m ruff format --check scripts/ tests/

step "[5/8] cargo run --quiet -- validate"
cargo run --quiet -- validate

step "[6/8] cargo run --quiet -- eval"
cargo run --quiet -- eval --json \
  | python3 -c "import sys,json; d=json.load(sys.stdin); checked=sum(x['golden_checked'] for x in d['scorecards']); ok=d['ok'] and d['rules_evaluated']>0 and checked>0; print(f\"  eval rules: {d['rules_evaluated']}; scanner-backed goldens: {checked}\"); sys.exit(0 if ok else 1)"

step "[7/8] cargo run --quiet -- scan src --lang rust (dogfood: 0 self-violations)"
cargo run --quiet -- scan src --lang rust --json --no-fail \
  | python3 -c "import sys,json; d=json.load(sys.stdin); ok=d['violations_count']==0 and d['config_issues_count']==0 and d['files_scanned']>0 and d['rules_applied']>0; print(f\"  self-scan: {d['files_scanned']} files, {d['rules_applied']} rules, {d['violations_count']} violations, {d['config_issues_count']} config issues\"); sys.exit(0 if ok else 1)"

step "[8/8] python3 -m pytest -q"
python3 -m pytest -q

step "All gates passed in $((SECONDS - started))s. Pushing."
