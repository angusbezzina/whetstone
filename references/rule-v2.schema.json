{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/angusbezzina/whetstone/references/rule-v2.schema.json",
  "title": "Whetstone rule v2 (whetstone.rule.v2)",
  "description": "One statement, one strength, exactly one mechanical enforcer, labelled examples and a source.",
  "$ref": "#/$defs/rule",
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "statement",
        "rationale",
        "strength",
        "enforcer",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "whetstone.rule.v2"
        },
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "enforcer": {
          "$ref": "#/$defs/enforcer"
        },
        "examples": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/rule_example"
          }
        },
        "source": {
          "$ref": "#/$defs/rule_source"
        },
        "paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sweep": {
          "enum": [
            "discuss",
            "confirm_first",
            "draft_pr"
          ],
          "description": "How a night sweep works the rule's flags; absent means discuss. Only a person widens it."
        }
      }
    },
    "strength": {
      "enum": [
        "must",
        "should"
      ]
    },
    "enforcer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "query"
          ],
          "properties": {
            "kind": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            },
            "language": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "lint"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool"
          ],
          "properties": {
            "kind": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "test"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "validator"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "feature"
          ],
          "properties": {
            "kind": {
              "const": "drive"
            },
            "feature": {
              "$ref": "#/$defs/record_id"
            }
          }
        }
      ]
    },
    "rule_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "expected",
        "reason"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonempty"
        },
        "expected": {
          "enum": [
            "pass",
            "flag"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "rule_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mission",
            "principle",
            "exemplar",
            "owner",
            "starter",
            "migration",
            "lesson"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonempty"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "locator"
      ],
      "properties": {
        "system": {
          "$ref": "#/$defs/nonempty"
        },
        "locator": {
          "$ref": "#/$defs/nonempty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    }
  }
}
