{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whetstone.dev/schemas/agreement-record-v1.schema.json",
  "title": "Whetstone agreement record v1 (delegation plan record kinds)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "scope",
    "owner",
    "provenance",
    "idempotency_key",
    "record_type",
    "record"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/record_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "owner": {
      "$ref": "#/$defs/principal"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "supersedes": {
      "$ref": "#/$defs/record_ref"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "record_type": {
      "enum": [
        "mission",
        "principle",
        "rule",
        "standard",
        "feature",
        "verification_map",
        "proposal",
        "local_review",
        "retirement",
        "verification_receipt",
        "lesson",
        "lesson_check"
      ]
    },
    "record": {
      "oneOf": [
        {
          "$ref": "#/$defs/mission"
        },
        {
          "$ref": "#/$defs/principle"
        },
        {
          "$ref": "#/$defs/rule"
        },
        {
          "$ref": "#/$defs/standard"
        },
        {
          "$ref": "#/$defs/feature"
        },
        {
          "$ref": "#/$defs/verification_map"
        },
        {
          "$ref": "#/$defs/proposal"
        },
        {
          "$ref": "#/$defs/local_review"
        },
        {
          "$ref": "#/$defs/retirement"
        },
        {
          "$ref": "#/$defs/verification_receipt"
        },
        {
          "$ref": "#/$defs/lesson"
        },
        {
          "$ref": "#/$defs/lesson_check"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "mission"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/mission"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "principle"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/principle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "rule"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/standard"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "feature"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "verification_map"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/verification_map"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/proposal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "local_review"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/local_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "retirement"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/retirement"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "verification_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/verification_receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "lesson"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "lesson_check"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/lesson_check"
          }
        }
      }
    }
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "scope_segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project"
      ],
      "properties": {
        "organization": {
          "$ref": "#/$defs/scope_segment"
        },
        "project": {
          "$ref": "#/$defs/scope_segment"
        },
        "component": {
          "$ref": "#/$defs/scope_segment"
        },
        "environment": {
          "$ref": "#/$defs/scope_segment"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stable_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_user",
            "github_user",
            "github_team",
            "github_app",
            "github_actions"
          ]
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "locator"
      ],
      "properties": {
        "system": {
          "$ref": "#/$defs/nonempty"
        },
        "locator": {
          "$ref": "#/$defs/nonempty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recorded_by",
        "recorded_at",
        "sources",
        "authority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human_authored",
            "dependency_documentation",
            "imported_note",
            "inferred_preference",
            "deterministic_check",
            "external_observation"
          ]
        },
        "recorded_by": {
          "$ref": "#/$defs/principal"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "authority": {
          "enum": [
            "candidate_only",
            "owner_authored",
            "independently_approved"
          ]
        }
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "external_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "stable_id"
      ],
      "properties": {
        "system": {
          "enum": [
            "beads",
            "github_pull_request",
            "github_release",
            "github_check_run",
            "incident",
            "deployment",
            "custom"
          ]
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "desired_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "rationale",
        "strength",
        "enforcement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "enforcement": {
          "$ref": "#/$defs/enforcement"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Earlier rule (v1); readable and enforced as a v2 rule. New revisions are written as `rule`."
    },
    "enforcement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "query"
          ],
          "properties": {
            "enforcement": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool",
            "code"
          ],
          "properties": {
            "enforcement": {
              "const": "lint_proxy"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool"
          ],
          "properties": {
            "enforcement": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "command_ref"
          ],
          "properties": {
            "enforcement": {
              "enum": [
                "test",
                "validator"
              ]
            },
            "command_ref": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "feature"
          ],
          "properties": {
            "enforcement": {
              "const": "drive"
            },
            "feature": {
              "$ref": "#/$defs/record_id"
            }
          }
        }
      ]
    },
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "payload_digest",
        "base_active_digest",
        "authority_revision",
        "expires_at"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "base_active_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "title",
        "rationale",
        "proposed_records"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "shared",
            "declined",
            "superseded"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "proposed_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        },
        "binding": {
          "$ref": "#/$defs/proposal_binding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "draft"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "binding"
              ]
            }
          },
          "else": {
            "required": [
              "binding"
            ]
          }
        }
      ]
    },
    "policy_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "$ref": "#/$defs/record_ref"
        },
        "required": {
          "$ref": "#/$defs/record_ref"
        },
        "installed": {
          "$ref": "#/$defs/record_ref"
        },
        "experimental": {
          "$ref": "#/$defs/record_ref"
        }
      }
    },
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "code_digest",
        "policy_state",
        "verification",
        "authorization",
        "freshness",
        "checked_at"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/external_ref"
        },
        "code_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_state": {
          "$ref": "#/$defs/policy_state"
        },
        "verification": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "authorization": {
          "enum": [
            "authorized",
            "denied",
            "unknown"
          ]
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "missing"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "related_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reason"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/record_ref"
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "replacement": {
          "$ref": "#/$defs/record_ref"
        }
      }
    },
    "text_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "record_id_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record_id"
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "area",
        "user_path",
        "proof"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "summary": {
          "$ref": "#/$defs/nonempty"
        },
        "area": {
          "$ref": "#/$defs/nonempty"
        },
        "sweep_order": {
          "type": "integer",
          "minimum": 0
        },
        "sub_features": {
          "$ref": "#/$defs/text_list"
        },
        "user_path": {
          "$ref": "#/$defs/nonempty"
        },
        "drive_steps": {
          "$ref": "#/$defs/text_list"
        },
        "proof": {
          "$ref": "#/$defs/nonempty"
        },
        "gotchas": {
          "$ref": "#/$defs/text_list"
        },
        "entry_points": {
          "$ref": "#/$defs/text_list"
        },
        "serves": {
          "$ref": "#/$defs/record_id_set"
        },
        "constrained_by": {
          "$ref": "#/$defs/record_id_set"
        },
        "proven_by": {
          "$ref": "#/$defs/record_id_set"
        },
        "index_summary": {
          "$ref": "#/$defs/nonempty"
        },
        "harness": {
          "$ref": "#/$defs/nonempty"
        },
        "preconditions": {
          "$ref": "#/$defs/text_list"
        },
        "drive_recipe": {
          "$ref": "#/$defs/text_list"
        },
        "mutations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        }
      }
    },
    "local_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "verdict",
        "reviewer",
        "assurance",
        "rationale",
        "reviewed_at",
        "team_activation_permitted"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/record_ref"
        },
        "verdict": {
          "enum": [
            "accept",
            "withdraw"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/principal"
        },
        "assurance": {
          "const": "solo-local"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "team_activation_permitted": {
          "const": false
        },
        "cites": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "description": "What the decision rested on, such as the origin lesson of a rule it accepts."
        }
      }
    },
    "verification_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "intro": {
          "$ref": "#/$defs/nonempty"
        },
        "baseline_preconditions": {
          "$ref": "#/$defs/text_list"
        },
        "driving_conventions": {
          "$ref": "#/$defs/text_list"
        },
        "proof_reporting": {
          "$ref": "#/$defs/text_list"
        },
        "entry_contract": {
          "$ref": "#/$defs/nonempty"
        },
        "skill_notes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "text"
            ],
            "properties": {
              "section": {
                "$ref": "#/$defs/nonempty"
              },
              "text": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "strength": {
      "enum": [
        "must",
        "should",
        "advisory"
      ]
    },
    "enforcer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "query"
          ],
          "properties": {
            "kind": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            },
            "language": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "lint"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool"
          ],
          "properties": {
            "kind": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "test"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "validator"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "feature"
          ],
          "properties": {
            "kind": {
              "const": "drive"
            },
            "feature": {
              "$ref": "#/$defs/record_id"
            }
          }
        }
      ]
    },
    "rule_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "expected",
        "reason"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonempty"
        },
        "expected": {
          "enum": [
            "pass",
            "flag"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "rule_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mission",
            "principle",
            "exemplar",
            "owner",
            "starter",
            "hardening",
            "migration",
            "lesson"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonempty"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "statement",
        "rationale",
        "strength",
        "enforcer",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "whetstone.rule.v2"
        },
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "enforcer": {
          "$ref": "#/$defs/enforcer"
        },
        "examples": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/rule_example"
          }
        },
        "source": {
          "$ref": "#/$defs/rule_source"
        },
        "paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sweep": {
          "enum": [
            "discuss",
            "confirm_first",
            "draft_pr"
          ],
          "description": "How a night sweep works the rule's flags; absent means discuss. Only a person widens it."
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "source"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "version"
              ],
              "properties": {
                "kind": {
                  "const": "pstack"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-z-]+$"
                },
                "version": {
                  "$ref": "#/$defs/nonempty"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "custom"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "record"
              ],
              "properties": {
                "kind": {
                  "const": "migrated"
                },
                "record": {
                  "$ref": "#/$defs/record_ref"
                }
              }
            }
          ]
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "find",
        "replace",
        "description"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "find": {
          "$ref": "#/$defs/nonempty"
        },
        "replace": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "lesson_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$"
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lesson v1: something learned, in words, for a person or a group. Proposed by anyone, admitted only by a person; the stamp is the store's, never the writer's.",
      "required": [
        "schema",
        "key",
        "text",
        "audience",
        "stamp",
        "trust",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "whetstone.lesson.v1"
        },
        "key": {
          "$ref": "#/$defs/lesson_key"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "about": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "repo"
                ],
                "properties": {
                  "kind": {
                    "const": "repo"
                  },
                  "repo": {
                    "$ref": "#/$defs/nonempty"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "locator"
                ],
                "properties": {
                  "kind": {
                    "const": "record"
                  },
                  "locator": {
                    "type": "string",
                    "pattern": "^[^:\\s]+:.+$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "path"
                  },
                  "path": {
                    "$ref": "#/$defs/nonempty"
                  }
                }
              }
            ]
          }
        },
        "concepts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "group"
              ]
            },
            "name": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "stamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "who",
            "actor",
            "at"
          ],
          "properties": {
            "who": {
              "$ref": "#/$defs/nonempty"
            },
            "actor": {
              "enum": [
                "person",
                "agent"
              ]
            },
            "session": {
              "type": "string"
            },
            "task": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "anchors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/nonempty"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "trust": {
          "enum": [
            "inferred",
            "validated",
            "authoritative"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "admitted",
            "superseded",
            "forgotten"
          ]
        },
        "supersedes": {
          "$ref": "#/$defs/lesson_key"
        },
        "superseded_by": {
          "$ref": "#/$defs/lesson_key"
        },
        "forget_proposed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "by",
            "at"
          ],
          "properties": {
            "reason": {
              "$ref": "#/$defs/nonempty"
            },
            "by": {
              "$ref": "#/$defs/nonempty"
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verb",
            "by",
            "at",
            "rationale"
          ],
          "properties": {
            "verb": {
              "enum": [
                "admit",
                "supersede",
                "forget"
              ]
            },
            "by": {
              "$ref": "#/$defs/nonempty"
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            },
            "rationale": {
              "$ref": "#/$defs/nonempty"
            },
            "receipt": {
              "$ref": "#/$defs/nonempty"
            }
          }
        }
      }
    },
    "lesson_check": {
      "type": "object",
      "additionalProperties": false,
      "description": "The cheap staleness check of one lesson revision: each anchor's recorded hash against the file now. No model is called.",
      "required": [
        "lesson",
        "key",
        "comparisons",
        "may_be_stale",
        "checked_at"
      ],
      "properties": {
        "lesson": {
          "$ref": "#/$defs/record_ref"
        },
        "key": {
          "$ref": "#/$defs/lesson_key"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "changed"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/nonempty"
              },
              "recorded": {
                "$ref": "#/$defs/digest"
              },
              "current": {
                "$ref": "#/$defs/digest"
              },
              "changed": {
                "type": "boolean"
              }
            }
          }
        },
        "may_be_stale": {
          "type": "boolean"
        },
        "commit": {
          "type": "string"
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "x-retired-kinds": {
    "description": "Kinds the delegation plan removed. Earlier records of these kinds are read exactly as stored (their digests verify) and appear in history; they can no longer be written.",
    "kinds": [
      "core_value",
      "implementation_philosophy",
      "metric_definition",
      "source_snapshot",
      "decision",
      "mandate",
      "activation",
      "observation_receipt",
      "policy_exception",
      "repair_session",
      "repair_handoff",
      "repair_authority_reservation",
      "repair_operation_claim",
      "hand_raise",
      "hand_answer",
      "attestation",
      "brief",
      "guidance",
      "judgment",
      "flag_decision"
    ]
  }
}
