{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whetstone.dev/schemas/agreement-record-v1.schema.json",
  "title": "Whetstone agreement record v1 (delegation plan record kinds)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "scope",
    "owner",
    "provenance",
    "idempotency_key",
    "record_type",
    "record"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/record_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "owner": {
      "$ref": "#/$defs/principal"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "supersedes": {
      "$ref": "#/$defs/record_ref"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "record_type": {
      "enum": [
        "mission",
        "principle",
        "rule",
        "standard",
        "proposal",
        "local_review",
        "retirement"
      ]
    },
    "record": {
      "oneOf": [
        {
          "$ref": "#/$defs/mission"
        },
        {
          "$ref": "#/$defs/principle"
        },
        {
          "$ref": "#/$defs/rule"
        },
        {
          "$ref": "#/$defs/standard"
        },
        {
          "$ref": "#/$defs/proposal"
        },
        {
          "$ref": "#/$defs/local_review"
        },
        {
          "$ref": "#/$defs/retirement"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "mission"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/mission"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "principle"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/principle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "rule"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/standard"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/proposal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "local_review"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/local_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "retirement"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/retirement"
          }
        }
      }
    }
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "scope_segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project"
      ],
      "properties": {
        "organization": {
          "$ref": "#/$defs/scope_segment"
        },
        "project": {
          "$ref": "#/$defs/scope_segment"
        },
        "component": {
          "$ref": "#/$defs/scope_segment"
        },
        "environment": {
          "$ref": "#/$defs/scope_segment"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stable_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_user",
            "github_user",
            "github_team",
            "github_app",
            "github_actions"
          ]
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "locator"
      ],
      "properties": {
        "system": {
          "$ref": "#/$defs/nonempty"
        },
        "locator": {
          "$ref": "#/$defs/nonempty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recorded_by",
        "recorded_at",
        "sources",
        "authority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human_authored",
            "dependency_documentation",
            "imported_note",
            "inferred_preference",
            "deterministic_check",
            "external_observation"
          ]
        },
        "recorded_by": {
          "$ref": "#/$defs/principal"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "authority": {
          "enum": [
            "candidate_only",
            "owner_authored",
            "independently_approved"
          ]
        }
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "desired_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "rationale",
        "strength",
        "enforcement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "enforcement": {
          "$ref": "#/$defs/enforcement"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Earlier rule (v1); readable and enforced as a v2 rule. New revisions are written as `rule`."
    },
    "enforcement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "query"
          ],
          "properties": {
            "enforcement": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool",
            "code"
          ],
          "properties": {
            "enforcement": {
              "const": "lint_proxy"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool"
          ],
          "properties": {
            "enforcement": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "command_ref"
          ],
          "properties": {
            "enforcement": {
              "enum": [
                "test",
                "validator"
              ]
            },
            "command_ref": {
              "$ref": "#/$defs/nonempty"
            }
          }
        }
      ]
    },
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "payload_digest",
        "base_active_digest",
        "authority_revision",
        "expires_at"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "base_active_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "title",
        "rationale",
        "proposed_records"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "shared",
            "declined",
            "superseded"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "proposed_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        },
        "binding": {
          "$ref": "#/$defs/proposal_binding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "draft"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "binding"
              ]
            }
          },
          "else": {
            "required": [
              "binding"
            ]
          }
        }
      ]
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reason"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/record_ref"
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "replacement": {
          "$ref": "#/$defs/record_ref"
        }
      }
    },
    "local_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "verdict",
        "reviewer",
        "assurance",
        "rationale",
        "reviewed_at",
        "team_activation_permitted"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/record_ref"
        },
        "verdict": {
          "enum": [
            "accept",
            "withdraw"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/principal"
        },
        "assurance": {
          "const": "solo-local"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "team_activation_permitted": {
          "const": false
        },
        "cites": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "description": "Evidence the decision rested on."
        }
      }
    },
    "strength": {
      "enum": [
        "must",
        "should"
      ]
    },
    "enforcer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "query"
          ],
          "properties": {
            "kind": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            },
            "language": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "lint"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool"
          ],
          "properties": {
            "kind": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "test"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "validator"
            },
            "command": {
              "$ref": "#/$defs/nonempty"
            }
          }
        }
      ]
    },
    "rule_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "expected",
        "reason"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonempty"
        },
        "expected": {
          "enum": [
            "pass",
            "flag"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "rule_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mission",
            "principle",
            "owner",
            "starter",
            "migration"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonempty"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "statement",
        "rationale",
        "strength",
        "enforcer",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "whetstone.rule.v2"
        },
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "enforcer": {
          "$ref": "#/$defs/enforcer"
        },
        "examples": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/rule_example"
          }
        },
        "source": {
          "$ref": "#/$defs/rule_source"
        },
        "paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sweep": {
          "enum": [
            "discuss",
            "confirm_first",
            "draft_pr"
          ],
          "description": "How a night sweep works the rule's flags; absent means discuss. Only a person widens it."
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "source"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "version"
              ],
              "properties": {
                "kind": {
                  "const": "pstack"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-z-]+$"
                },
                "version": {
                  "$ref": "#/$defs/nonempty"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "custom"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "record"
              ],
              "properties": {
                "kind": {
                  "const": "migrated"
                },
                "record": {
                  "$ref": "#/$defs/record_ref"
                }
              }
            }
          ]
        }
      }
    }
  },
  "x-retired-kinds": {
    "description": "Kinds the delegation plan removed. Earlier records of these kinds are read exactly as stored (their digests verify) and appear in history; they can no longer be written.",
    "kinds": [
      "core_value",
      "implementation_philosophy",
      "metric_definition",
      "source_snapshot",
      "decision",
      "mandate",
      "activation",
      "observation_receipt",
      "policy_exception",
      "repair_session",
      "repair_handoff",
      "repair_authority_reservation",
      "repair_operation_claim",
      "hand_raise",
      "hand_answer",
      "attestation",
      "brief",
      "guidance",
      "judgment",
      "flag_decision",
      "lesson",
      "lesson_check",
      "feature",
      "verification_map",
      "verification_receipt"
    ]
  }
}
