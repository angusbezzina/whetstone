{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whetstone.dev/schemas/agreement-record-v1.schema.json",
  "title": "Whetstone agreement record v1 (delegation plan record kinds)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "scope",
    "owner",
    "provenance",
    "idempotency_key",
    "record_type",
    "record"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/record_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "owner": {
      "$ref": "#/$defs/principal"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "supersedes": {
      "$ref": "#/$defs/record_ref"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "record_type": {
      "enum": [
        "mission",
        "principle",
        "rule",
        "standard",
        "guidance",
        "feature",
        "verification_map",
        "proposal",
        "local_review",
        "retirement",
        "verification_receipt",
        "judgment",
        "attestation",
        "brief",
        "flag_decision",
        "hand_raise",
        "hand_answer"
      ]
    },
    "record": {
      "oneOf": [
        {
          "$ref": "#/$defs/mission"
        },
        {
          "$ref": "#/$defs/principle"
        },
        {
          "$ref": "#/$defs/rule"
        },
        {
          "$ref": "#/$defs/standard"
        },
        {
          "$ref": "#/$defs/guidance"
        },
        {
          "$ref": "#/$defs/feature"
        },
        {
          "$ref": "#/$defs/verification_map"
        },
        {
          "$ref": "#/$defs/proposal"
        },
        {
          "$ref": "#/$defs/local_review"
        },
        {
          "$ref": "#/$defs/retirement"
        },
        {
          "$ref": "#/$defs/verification_receipt"
        },
        {
          "$ref": "#/$defs/judgment"
        },
        {
          "$ref": "#/$defs/attestation"
        },
        {
          "$ref": "#/$defs/brief"
        },
        {
          "$ref": "#/$defs/flag_decision"
        },
        {
          "$ref": "#/$defs/hand_raise"
        },
        {
          "$ref": "#/$defs/hand_answer"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "mission"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/mission"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "principle"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/principle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "rule"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/standard"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "guidance"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/guidance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "feature"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "verification_map"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/verification_map"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/proposal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "local_review"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/local_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "retirement"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/retirement"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "verification_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/verification_receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "judgment"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/judgment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "attestation"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "brief"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/brief"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "flag_decision"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/flag_decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "hand_raise"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/hand_raise"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "hand_answer"
          }
        }
      },
      "then": {
        "properties": {
          "record": {
            "$ref": "#/$defs/hand_answer"
          }
        }
      }
    }
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "scope_segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project"
      ],
      "properties": {
        "organization": {
          "$ref": "#/$defs/scope_segment"
        },
        "project": {
          "$ref": "#/$defs/scope_segment"
        },
        "component": {
          "$ref": "#/$defs/scope_segment"
        },
        "environment": {
          "$ref": "#/$defs/scope_segment"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stable_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_user",
            "github_user",
            "github_team",
            "github_app",
            "github_actions"
          ]
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "locator"
      ],
      "properties": {
        "system": {
          "$ref": "#/$defs/nonempty"
        },
        "locator": {
          "$ref": "#/$defs/nonempty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recorded_by",
        "recorded_at",
        "sources",
        "authority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human_authored",
            "dependency_documentation",
            "imported_note",
            "inferred_preference",
            "deterministic_check",
            "external_observation"
          ]
        },
        "recorded_by": {
          "$ref": "#/$defs/principal"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "authority": {
          "enum": [
            "candidate_only",
            "owner_authored",
            "independently_approved"
          ]
        }
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "external_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "stable_id"
      ],
      "properties": {
        "system": {
          "enum": [
            "beads",
            "github_pull_request",
            "github_release",
            "github_check_run",
            "incident",
            "deployment",
            "custom"
          ]
        },
        "stable_id": {
          "$ref": "#/$defs/nonempty"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "desired_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "rationale",
        "strength",
        "enforcement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "strength": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "enforcement": {
          "$ref": "#/$defs/enforcement"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Earlier rule (v1); readable and enforced as a v2 rule. New revisions are written as `rule`."
    },
    "enforcement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "query"
          ],
          "properties": {
            "enforcement": {
              "const": "ast"
            },
            "query": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool",
            "code"
          ],
          "properties": {
            "enforcement": {
              "const": "lint_proxy"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            },
            "code": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "tool"
          ],
          "properties": {
            "enforcement": {
              "const": "formatter"
            },
            "tool": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "command_ref"
          ],
          "properties": {
            "enforcement": {
              "enum": [
                "test",
                "validator"
              ]
            },
            "command_ref": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforcement",
            "feature"
          ],
          "properties": {
            "enforcement": {
              "const": "drive"
            },
            "feature": {
              "$ref": "#/$defs/record_id"
            }
          }
        }
      ]
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "rationale"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Earlier advisory guidance; read as an advisory rule reviewed by /interrogate."
    },
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "payload_digest",
        "base_active_digest",
        "authority_revision",
        "expires_at"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "base_active_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "title",
        "rationale",
        "proposed_records"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "shared",
            "declined",
            "superseded"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "proposed_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        },
        "binding": {
          "$ref": "#/$defs/proposal_binding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "draft"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "binding"
              ]
            }
          },
          "else": {
            "required": [
              "binding"
            ]
          }
        }
      ]
    },
    "policy_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "$ref": "#/$defs/record_ref"
        },
        "required": {
          "$ref": "#/$defs/record_ref"
        },
        "installed": {
          "$ref": "#/$defs/record_ref"
        },
        "experimental": {
          "$ref": "#/$defs/record_ref"
        }
      }
    },
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "code_digest",
        "policy_state",
        "verification",
        "authorization",
        "freshness",
        "checked_at"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/external_ref"
        },
        "code_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_state": {
          "$ref": "#/$defs/policy_state"
        },
        "verification": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "authorization": {
          "enum": [
            "authorized",
            "denied",
            "unknown"
          ]
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "missing"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "related_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reason"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/record_ref"
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "replacement": {
          "$ref": "#/$defs/record_ref"
        }
      }
    },
    "text_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "record_id_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record_id"
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "area",
        "user_path",
        "proof"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "summary": {
          "$ref": "#/$defs/nonempty"
        },
        "area": {
          "$ref": "#/$defs/nonempty"
        },
        "sweep_order": {
          "type": "integer",
          "minimum": 0
        },
        "sub_features": {
          "$ref": "#/$defs/text_list"
        },
        "user_path": {
          "$ref": "#/$defs/nonempty"
        },
        "drive_steps": {
          "$ref": "#/$defs/text_list"
        },
        "proof": {
          "$ref": "#/$defs/nonempty"
        },
        "gotchas": {
          "$ref": "#/$defs/text_list"
        },
        "entry_points": {
          "$ref": "#/$defs/text_list"
        },
        "serves": {
          "$ref": "#/$defs/record_id_set"
        },
        "constrained_by": {
          "$ref": "#/$defs/record_id_set"
        },
        "proven_by": {
          "$ref": "#/$defs/record_id_set"
        },
        "index_summary": {
          "$ref": "#/$defs/nonempty"
        },
        "harness": {
          "$ref": "#/$defs/nonempty"
        },
        "preconditions": {
          "$ref": "#/$defs/text_list"
        },
        "drive_recipe": {
          "$ref": "#/$defs/text_list"
        },
        "mutations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        }
      }
    },
    "local_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "verdict",
        "reviewer",
        "assurance",
        "rationale",
        "reviewed_at",
        "team_activation_permitted"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/record_ref"
        },
        "verdict": {
          "enum": [
            "accept",
            "withdraw"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/principal"
        },
        "assurance": {
          "const": "solo-local"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "team_activation_permitted": {
          "const": false
        }
      }
    },
    "verification_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "intro": {
          "$ref": "#/$defs/nonempty"
        },
        "baseline_preconditions": {
          "$ref": "#/$defs/text_list"
        },
        "driving_conventions": {
          "$ref": "#/$defs/text_list"
        },
        "proof_reporting": {
          "$ref": "#/$defs/text_list"
        },
        "entry_contract": {
          "$ref": "#/$defs/nonempty"
        },
        "skill_notes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "text"
            ],
            "properties": {
              "section": {
                "$ref": "#/$defs/nonempty"
              },
              "text": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "strength": {
      "enum": [
        "must",
        "should",
        "advisory"
      ]
    },
    "reviewer": {
