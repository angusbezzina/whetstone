{
  "schema_version": 2,
  "source": "planning/direction.md (delegation plan, whetstone-ppq): rule v2, receipts, and retired kinds",
  "expectations": {
    "valid": "parses, validates, appends once, and its canonical bytes are a fixed point of parse and serialize",
    "parse_error": "the record body does not deserialize",
    "invalid": "the record body deserializes but validation refuses it",
    "stored": "a rule revision read through its mapping and enforced as that rule; its stored bytes and digest are kept",
    "retired": "read exactly as stored as a retired kind; appending it is refused"
  },
  "cases": [
    {
      "id": "R-001",
      "name": "must rule held by one test enforcer",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Prove it works before claiming it does.",
        "rationale": "Evidence before assertion.",
        "strength": "must",
        "enforcer": { "kind": "test", "command": "cargo test" },
        "source": { "kind": "starter", "reference": "pstack:prove-it-works" }
      },
      "expect": "valid"
    },
    {
      "id": "R-002",
      "name": "a rule never carries two enforcers",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Prove it works.",
        "rationale": "Evidence.",
        "strength": "must",
        "enforcer": { "kind": "test", "command": "cargo test" },
        "enforcers": [{ "kind": "review", "reviewer": { "by": "interrogate" } }],
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-003",
      "name": "one enforcer never carries another enforcer's fields",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Tests only when asked.",
        "rationale": "Scope.",
        "strength": "should",
        "enforcer": { "kind": "test", "command": "cargo test", "question": "Does this change add tests nobody asked for?" },
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-006",
      "name": "strength is must or should only",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Keep diffs small.",
        "rationale": "Review cost.",
        "strength": "may",
        "enforcer": { "kind": "test", "command": "cargo test" },
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-007",
      "name": "a local-only question rule is read as history",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Never log customer email addresses.",
        "rationale": "Privacy.",
        "strength": "should",
        "enforcer": { "kind": "question", "question": "Does this change log an email address?" },
        "source": { "kind": "owner" },
        "paths": ["src/**"],
        "hand_raise": ["low_confidence", "unavailable"],
        "privacy": { "redact_globs": ["secrets/**"], "redact_patterns": ["[a-z]+@example\\.com"], "local_only": true }
      },
      "expect": "retired"
    },
    {
      "id": "R-008",
      "name": "labelled examples define the rule",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "No unwrap in library code.",
        "rationale": "Panics are not errors.",
        "strength": "should",
        "enforcer": { "kind": "ast", "query": "(call_expression) @call", "language": "rust" },
        "examples": [
          { "input": "let x = y.unwrap();", "expected": "flag", "reason": "unwrap panics", "path": "src/lib.rs" },
          { "input": "let x = y?;", "expected": "pass", "reason": "propagates the error" }
        ],
        "source": { "kind": "owner", "provenance": [{ "system": "git", "locator": "src/lib.rs" }] }
      },
      "expect": "valid"
    },
    {
      "id": "R-009",
      "name": "example paths stay inside the repository",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "No unwrap.",
        "rationale": "Panics.",
        "strength": "should",
        "enforcer": { "kind": "lint", "tool": "clippy", "code": "clippy::unwrap_used" },
        "examples": [{ "input": "y.unwrap()", "expected": "flag", "reason": "panics", "path": "../outside.rs" }],
        "source": { "kind": "owner" }
      },
      "expect": "invalid"
    },
