{
  "schema_version": 2,
  "source": "planning/direction.md (delegation plan, whetstone-ppq): rule v2, receipts, and retired kinds",
  "expectations": {
    "valid": "parses, validates, appends once, and its canonical bytes are a fixed point of parse and serialize",
    "parse_error": "the record body does not deserialize",
    "invalid": "the record body deserializes but validation refuses it",
    "retired": "read exactly as stored as a retired kind; appending it is refused"
  },
  "cases": [
    {
      "id": "R-001",
      "name": "must rule held by one test enforcer",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Prove it works before claiming it does.",
        "rationale": "Evidence before assertion.",
        "strength": "must",
        "enforcer": { "kind": "test", "command": "cargo test" },
        "source": { "kind": "starter", "reference": "pstack:prove-it-works" }
      },
      "expect": "valid",
      "family": "mechanical"
    },
    {
      "id": "R-002",
      "name": "a rule never carries two enforcers",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Prove it works.",
        "rationale": "Evidence.",
        "strength": "must",
        "enforcer": { "kind": "test", "command": "cargo test" },
        "enforcers": [{ "kind": "review", "reviewer": { "by": "interrogate" } }],
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-003",
      "name": "one enforcer cannot mix a question with a command",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Tests only when asked.",
        "rationale": "Scope.",
        "strength": "should",
        "enforcer": { "kind": "question", "question": "Does this change add tests nobody asked for?", "command": "cargo test" },
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-004",
      "name": "a question starts in shadow with the pinned model and default bars",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Add tests only when the task asks for them.",
        "rationale": "Unrequested tests widen the change.",
        "strength": "should",
        "enforcer": { "kind": "question", "question": "Does this change add tests the task did not ask for?" },
        "source": { "kind": "starter", "reference": "pstack:laziness-protocol" }
      },
      "expect": "valid",
      "family": "question",
      "shadow": true,
      "serializes_enforcer_as": {
        "kind": "question",
        "question": "Does this change add tests the task did not ask for?",
        "unit": "hunk",
        "model": "jev-1.13.0",
        "shadow": true,
        "threshold_bp": 5000,
        "confidence_bar_bp": 4000,
        "promote_after": 50,
        "precision_bar_bp": 9000
      }
    },
    {
      "id": "R-005",
      "name": "a promoted question is enforced only when shadow is explicitly false",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Add tests only when asked.",
        "rationale": "Scope.",
        "strength": "should",
        "enforcer": { "kind": "question", "question": "Does this change add unrequested tests?", "shadow": false },
        "source": { "kind": "owner" }
      },
      "expect": "valid",
      "family": "question",
      "shadow": false
    },
    {
      "id": "R-006",
      "name": "strength is must, should or advisory only",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Keep diffs small.",
        "rationale": "Review cost.",
        "strength": "may",
        "enforcer": { "kind": "review", "reviewer": { "by": "interrogate" } },
        "source": { "kind": "owner" }
      },
      "expect": "parse_error"
    },
    {
      "id": "R-007",
      "name": "a local-only question keeps its privacy and redactions",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "Never log customer email addresses.",
        "rationale": "Privacy.",
        "strength": "should",
        "enforcer": { "kind": "question", "question": "Does this change log an email address?" },
        "source": { "kind": "owner" },
        "paths": ["src/**"],
        "hand_raise": ["low_confidence", "unavailable"],
        "privacy": { "redact_globs": ["secrets/**"], "redact_patterns": ["[a-z]+@example\\.com"], "local_only": true }
      },
      "expect": "valid",
      "family": "question",
      "shadow": true,
      "local_only": true
    },
    {
      "id": "R-008",
      "name": "labelled examples define the rule",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "No unwrap in library code.",
        "rationale": "Panics are not errors.",
        "strength": "should",
        "enforcer": { "kind": "ast", "query": "(call_expression) @call", "language": "rust" },
        "examples": [
          { "input": "let x = y.unwrap();", "expected": "flag", "reason": "unwrap panics", "path": "src/lib.rs" },
          { "input": "let x = y?;", "expected": "pass", "reason": "propagates the error" }
        ],
        "source": { "kind": "exemplar", "reference": "https://example.test/repo", "provenance": [{ "system": "git", "locator": "src/lib.rs" }] }
      },
      "expect": "valid",
      "family": "mechanical"
    },
    {
      "id": "R-009",
      "name": "example paths stay inside the repository",
      "record_type": "rule",
      "record": {
        "schema": "whetstone.rule.v2",
        "statement": "No unwrap.",
        "rationale": "Panics.",
        "strength": "should",
        "enforcer": { "kind": "lint", "tool": "clippy", "code": "clippy::unwrap_used" },
        "examples": [{ "input": "y.unwrap()", "expected": "flag", "reason": "panics", "path": "../outside.rs" }],
        "source": { "kind": "owner" }
      },
      "expect": "invalid"
    },
    {
      "id": "R-010",
      "name": "only rule schema v2 is written",
